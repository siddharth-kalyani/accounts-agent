# Cloud Run settings, set by the deploy command in documents/GCP_DEPLOYMENT.md.
# Never commit actual values. Secrets come from Secret Manager, not this file.
APP_ENV=production
APP_ORIGIN=https://SERVICE-PROJECT_NUMBER.REGION.run.app
GCS_RECEIPTS_BUCKET=YOUR-RECEIPTS-BUCKET
VERTEX_PROJECT=YOUR-PROJECT-ID
VERTEX_LOCATION=asia-south1
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_RECEIPT_MODEL=gemini-3.8-flash
SEED_SUPERADMIN_EMAIL=Siddharth.Kalyani@intuitive.AI
SEED_SUPERADMIN_NAME=Siddharth Kalyani
# From Secret Manager (--set-secrets):
# SESSION_SECRET=session-secret
# DATABASE_URL=postgresql://DB_USER:PASSWORD@/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# BOOTSTRAP_SUPERADMIN_PASSWORD=bootstrap-admin-password (first sign-in only, then removed)
# Microsoft sign-in stays off while every ENTRA_* setting is absent. To turn it
# on later, set all of ENTRA_TENANT_ID, ENTRA_CLIENT_ID, ENTRA_CLIENT_SECRET,
# ENTRA_REDIRECT_URI (APP_ORIGIN + /api/auth/callback) and SEED_SUPERADMIN_OBJECT_ID.
