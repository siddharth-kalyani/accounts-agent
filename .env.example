APP_ORIGIN=http://127.0.0.1:5173
# Local development uses SQLite and local receipt files. Production requires
# PostgreSQL (Cloud SQL) and a private Cloud Storage bucket.
APP_ENV=development
DATABASE_URL=
# Only for a local PostgreSQL instance; production always verifies TLS.
PGSSL=
PANTRY_DATA_DIR=
PANTRY_DB=
PANTRY_HOST=127.0.0.1
# Trust only a loopback reverse proxy when 1. Cloud Run uses X-Forwarded-For.
PANTRY_TRUST_PROXY=0
GCS_RECEIPTS_BUCKET=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback
SEED_SUPERADMIN_EMAIL=Siddharth.Kalyani@intuitive.AI
SEED_SUPERADMIN_NAME=Siddharth Kalyani
SEED_SUPERADMIN_OBJECT_ID=
SESSION_SECRET=
PORT=8787
# The assistant stays off until both are set. Locally it signs in to Google
# with `gcloud auth application-default login`; that login needs Agent Platform User.
VERTEX_PROJECT=
VERTEX_LOCATION=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_RECEIPT_MODEL=gemini-3.8-flash
